# Required
DR_OPENAI_API_KEY=sk-...

# Models (optional — defaults shown)
DR_DEFAULT_MODEL=gpt-4o-mini
DR_WRITING_MODEL=gpt-4o
DR_ORCHESTRATOR_MODEL=gpt-4o

# Search settings
DR_MAX_SEARCHES=5
DR_MAX_RESULTS_PER_SEARCH=5
DR_MAX_SCRAPE_URLS=10
DR_SEARCH_RATE_LIMIT_DELAY=1.0

# Clarification
DR_MAX_FOLLOW_UP_QUESTIONS=3

# Report
DR_MAX_REVISIONS=2
DR_MIN_REPORT_WORDS=1000
DR_REVISION_THRESHOLD=7.0

# Token budget
DR_MAX_TOKENS_PER_SESSION=100000

# Guardrails
DR_HALLUCINATION_CHECK_ENABLED=false

# Email (optional)
DR_EMAIL_ENABLED=false
DR_EMAIL_ADDRESS=
DR_EMAIL_SMTP_SERVER=
DR_EMAIL_APP_PASSWORD=

# Server
DR_HOST=0.0.0.0
DR_PORT=8000
DR_DEBUG=false
DR_LOG_LEVEL=INFO
